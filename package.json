{
  "name": "katie-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "dev:demo": "VITE_DEMO_DEFAULT=1 vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && VITE_DEMO_DEFAULT=1 vite build --outDir dist-demo/dash --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@vibe/core": "^4.5.36",
    "@vibe/icons": "^4.2.0",
    "aws-amplify": "6.22.2",
    "gsap": "^3.15.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
